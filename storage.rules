rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isActiveAdmin() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.role == 'admin'
        && firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    // Ảnh bìa bài viết được công khai để website hiển thị.
    // Chỉ quản trị viên đang hoạt động mới được tải lên/thay thế/xóa.
    match /article-covers/{articleId}/{fileName} {
      allow read: if true;
      allow write: if isActiveAdmin()
        && (
          request.resource == null
          || (
            request.resource.size < 5 * 1024 * 1024
            && request.resource.contentType.matches('image/(jpeg|png|webp|gif)')
          )
        );
    }
  }
}
